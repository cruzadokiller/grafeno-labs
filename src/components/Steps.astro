---
interface Props {
  steps: { n: string; title: string; text: string }[];
}

const { steps } = Astro.props;
---

<div class="steps reveal d1">
  {
    steps.map((s) => (
      <div class="step">
        <div class="n">{s.n}</div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))
  }
</div>
