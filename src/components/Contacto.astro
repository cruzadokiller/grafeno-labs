---
import { CONTACT_EMAIL, whatsappUrl } from "@/lib/site";

const points = [
  "Partimos por entender tu desafío y tus objetivos",
  "Propuesta clara con plazos y entregables",
  "Comunicación directa con quien decide",
  "Resultados medibles desde la primera iteración",
];

const projectTypes = ["Marketing digital", "Admisión y educación", "eCommerce", "Tecnología e IA", "Otro / no estoy seguro"];

const WA_ICON =
  "M12 2a10 10 0 0 0-8.7 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.2 14.8l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 0 1 12 4zm4.3 10.1c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5c.1-.1.1-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.7.7-.9 1.6-.6 2.6.6 1.9 1.9 3.3 3.8 4.2 1.4.7 2.3.7 3 .5.5-.1 1.4-.6 1.6-1.2.2-.5.2-1 .1-1.1l-.4-.3z";
---

<section id="contacto" class="cta-final">
  <div class="wrap">
    <div class="cta-grid">
      <div class="reveal">
        <span class="eyebrow">Conversemos</span>
        <h2>Cuéntanos tu <span class="chrome">desafío</span>.</h2>
        <p class="lead">
          Si tienes un problema concreto que resolver, una hipótesis que validar o un ecosistema que modernizar, empecemos
          por una conversación.
        </p>
        <div class="cta-points">
          {
            points.map((p) => (
              <div>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                {p}
              </div>
            ))
          }
        </div>
        <div class="direct">
          <a href={whatsappUrl("Hola Grafeno Labs, quiero conversar un proyecto")} class="btn-wa" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={WA_ICON} /></svg>
            Escríbenos por WhatsApp
          </a>
          <a href={`mailto:${CONTACT_EMAIL}`} class="direct-mail">{CONTACT_EMAIL}</a>
        </div>
      </div>

      <div class="form-card reveal d1">
        <form id="leadForm" autocomplete="on" novalidate>
          <span class="tag">Formulario seguro</span>
          <h3>Trabajemos juntos.</h3>
          <div class="field">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" type="text" placeholder="Tu nombre" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="empresa">Empresa</label>
            <input id="empresa" name="empresa" type="text" placeholder="Nombre de tu empresa" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="nombre@empresa.com" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="telefono">Teléfono <span class="opt">(opcional)</span></label>
            <div class="phone">
              <span>+569</span>
              <input id="telefono" name="telefono" type="tel" inputmode="numeric" placeholder="12345678" maxlength="8" pattern="\d{8}" />
            </div>
          </div>
          <div class="field">
            <label id="reto-label">Tipo de proyecto</label>
            <div class="select" data-select>
              <input type="hidden" name="reto" />
              <button type="button" class="select-btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="reto-label reto-value">
                <span id="reto-value">Selecciona una opción</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
              </button>
              <ul class="select-list" role="listbox" aria-labelledby="reto-label">
                {projectTypes.map((t) => <li role="option" tabindex="-1" aria-selected="false">{t}</li>)}
              </ul>
            </div>
          </div>
          <div class="field">
            <label for="mensaje">Contexto <span class="opt">(opcional)</span></label>
            <textarea id="mensaje" name="mensaje" placeholder="Cuéntanos qué quieres lograr"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            <span data-label>Enviar mensaje</span> <span class="arrow">→</span>
          </button>
          <p class="form-error" role="alert" hidden></p>
          <p class="form-note">Te respondemos en menos de 24 horas hábiles.</p>
        </form>
        <div class="form-success" id="formSuccess" role="status">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
          <h3 class="chrome">Mensaje recibido</h3>
          <p>Gracias. Un miembro del laboratorio revisará tu caso y te contactará pronto.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("leadForm") as HTMLFormElement;
  const success = document.getElementById("formSuccess")!;
  const errorEl = form.querySelector<HTMLParagraphElement>(".form-error")!;
  const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const submitLabel = submitBtn.querySelector<HTMLSpanElement>("[data-label]")!;

  // ---- selector propio (mismo look que el resto del formulario) ----
  const select = form.querySelector<HTMLDivElement>("[data-select]")!;
  const hidden = select.querySelector<HTMLInputElement>('input[type="hidden"]')!;
  const trigger = select.querySelector<HTMLButtonElement>(".select-btn")!;
  const valueEl = select.querySelector<HTMLSpanElement>("#reto-value")!;
  const options = [...select.querySelectorAll<HTMLLIElement>('[role="option"]')];

  const setOpen = (open: boolean) => {
    select.classList.toggle("open", open);
    trigger.setAttribute("aria-expanded", String(open));
    if (open) (options.find((o) => o.getAttribute("aria-selected") === "true") ?? options[0]).focus();
  };
  const choose = (opt: HTMLLIElement) => {
    options.forEach((o) => o.setAttribute("aria-selected", String(o === opt)));
    hidden.value = opt.textContent ?? "";
    valueEl.textContent = hidden.value;
    trigger.classList.add("has-value");
    select.classList.remove("select-error");
    setOpen(false);
    trigger.focus();
  };

  trigger.addEventListener("click", () => setOpen(!select.classList.contains("open")));
  options.forEach((opt, i) => {
    opt.addEventListener("click", () => choose(opt));
    opt.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        choose(opt);
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        options[Math.min(i + 1, options.length - 1)].focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        options[Math.max(i - 1, 0)].focus();
      } else if (e.key === "Escape") {
        setOpen(false);
        trigger.focus();
      }
    });
  });
  document.addEventListener("mousedown", (e) => {
    if (!select.contains(e.target as Node)) setOpen(false);
  });

  // ---- telefono: solo digitos, maximo 8 ----
  const tel = form.querySelector<HTMLInputElement>("#telefono")!;
  tel.addEventListener("input", () => {
    tel.value = tel.value.replace(/\D/g, "").slice(0, 8);
  });

  // ---- envio ----
  const showError = (msg: string) => {
    errorEl.textContent = msg;
    errorEl.hidden = false;
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (!hidden.value) {
      select.classList.add("select-error");
      showError("Selecciona el tipo de proyecto.");
      trigger.focus();
      return;
    }

    const data = new FormData(form);
    const payload = {
      nombre: String(data.get("nombre") || ""),
      empresa: String(data.get("empresa") || ""),
      email: String(data.get("email") || ""),
      telefono: data.get("telefono") ? `+569${data.get("telefono")}` : "",
      reto: hidden.value,
      mensaje: String(data.get("mensaje") || ""),
    };

    submitBtn.disabled = true;
    submitLabel.textContent = "Enviando…";
    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => null);
        throw new Error(body?.error || "No se pudo enviar el mensaje.");
      }
      // Conversion para GA4: gtag existe desde la carga y encola el evento si gtag.js aun no llego.
      window.gtag?.("event", "generate_lead", { form_id: "leadForm", project_type: payload.reto });
      form.hidden = true;
      success.classList.add("show");
    } catch (err) {
      showError(err instanceof Error ? err.message : "No se pudo enviar el mensaje.");
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = "Enviar mensaje";
    }
  });
</script>
