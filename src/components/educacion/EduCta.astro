---
import { CONTACT_EMAIL, whatsappUrl } from "@/lib/site";
---

<section id="contacto-edu" class="edu-cta">
  <div class="wrap">
    <span class="eyebrow reveal">Conversemos</span>
    <h2 class="reveal d1">Partamos por <span class="chrome">entender tu proceso</span>.</h2>
    <p class="reveal d2">
      Nos reunimos con tu equipo para conocer tus metas de matrícula y tu operación actual, y te proponemos un assessment a
      la medida.
    </p>
    <div class="edu-cta-actions reveal d2">
      <a href={whatsappUrl("Hola Grafeno Labs, quiero conversar sobre admisión")} class="btn btn-primary" target="_blank" rel="noopener">
        Agendar por WhatsApp <span class="arrow">→</span>
      </a>
      <a href="/#contacto" class="btn btn-ghost">Dejar mis datos</a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="edu-mail">{CONTACT_EMAIL}</a>
    </div>
  </div>
</section>
