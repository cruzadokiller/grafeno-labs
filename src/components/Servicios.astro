---
import SectionHead from "./SectionHead.astro";
import ServiceCard, { type Props as Service } from "./ServiceCard.astro";
import { ICON_CUBE, ICON_PULSE, ICON_SPARK } from "./icons";

const services: Service[] = [
  {
    num: "01",
    icon: ICON_PULSE,
    title: "Marketing digital",
    text: "Hacemos que te encuentren y te elijan: posicionamiento, medios pagados y contenidos que atraen a la audiencia correcta.",
    items: ["Posicionamiento orgánico (SEO · GEO · AEO)", "Medios pagados (Google Ads · Meta · RRSS)", "Estrategia de contenidos y marca"],
  },
  {
    num: "02",
    icon: ICON_CUBE,
    title: "Funnels & ventas digitales",
    text: "Convertimos el tráfico en clientes: landing pages, optimización de conversión y gestión de leads conectada a tu proceso comercial.",
    items: ["Landing pages y funnels de conversión", "Arquitectura de medición y marcaje (GTM · GA4)", "CRM y gestión de leads"],
    delay: "d1",
  },
  {
    num: "03",
    icon: ICON_SPARK,
    title: "Tecnología e IA",
    text: "Construimos la plataforma que sostiene todo: desarrollo web y de apps, MVPs, automatización y agentes de IA que ahorran horas.",
    items: ["Desarrollo web, apps y MVPs (spec-driven con IA)", "Agentes, RAG y automatización de procesos", "Integraciones: CRM, APIs y datos"],
    delay: "d2",
  },
];
---

<section id="servicios">
  <div class="wrap">
    <SectionHead eyebrow="Servicios" center>
      <Fragment slot="title">Tres frentes, un mismo objetivo: que todo <span class="chrome">venda</span>.</Fragment>
      Cada frente se traduce en resultados de negocio medibles: más tráfico cualificado, más conversión y más ventas o
      matrículas.
    </SectionHead>
    <div class="services-grid">
      {services.map((s) => <ServiceCard {...s} />)}
    </div>
  </div>
</section>
